# environments
.venv/
.venv-rel/
.venv-zoo/
__pycache__/
*.pyc
.ipynb_checkpoints/

# competition data (not redistributable) and local caches rebuilt by eda/common.py
data/
data_pq/

# local dry-run outputs
output/
output_v*/
catboost_info/

# large derived artefacts, regenerable by the scripts that wrote them
eda/deep/out/relational/
eda/deep/out/preprocessed/
eda/*/out/*.parquet
eda/out/*.parquet
results/**/features.parquet
eda/*/out/*.npz
!eda/v8_review/out/*.parquet
results/v4/v4/features_*.parquet

# baseline DuckDB EDA outputs (only the risk exploration tables/figures are kept)
outputs/*
!outputs/04_risk_exploration/
outputs/04_risk_exploration/*.parquet

# research PDFs, re-download with research/download_papers.py
research/papers/

# model weights
*.pt
*.pkl
*.cbm
*.ubj

# training checkpoints / logs written by pytorch-lightning (pytabkit TabR, TabM) and local runners
checkpoints/
lightning_logs/
*.ckpt

# credentials (shared by both research sources)
.env
.env.*
secrets.env
*kaggle*.json
.kaggle/

# additional local model formats and isolated environments
.venv-*/
*.joblib
*.safetensors
*.onnx

# teammate pipeline: retain reports, tables, figures and provenance, exclude caches
artifacts/**
!artifacts/**/
!artifacts/**/*.md
!artifacts/**/*.html
!artifacts/**/*.json
!artifacts/figures/*.png
!artifacts/tables/*.csv
artifacts/notebook_runs/
eda/out/integration_build_smoke/

# GitHub contains source, compact reports and archived recipes. Keep the large
# local experiment store and submissions on disk without publishing predictions.
/results/
/submissions/**/*.csv
/submissions/*.csv
/log/
*.log
*.parquet
*.npy
